{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "share-serverless-console",
	"main": "src/worker.ts",
	"compatibility_date": "2026-11-10",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true,
	},
	"services": [{ "binding": "API", "service": "share-serverless-api" }],
	"env": {
		"e2e": {
			"name": "share-serverless-console-e2e",
			"services": [{ "binding": "API", "service": "share-serverless-api-e2e" }],
		},
	},
	"observability": { "enabled": true },
}
