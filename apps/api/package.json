{
	"name": "@share/api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --ip 127.0.0.1 --port 8787 --var PUBLIC_BASE_URL:http://127.0.0.1:8787",
		"build": "wrangler deploy --dry-run --outdir dist",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
		"test": "vitest run",
		"cf:typegen": "wrangler types --env-file typegen.env --strict-vars=false",
		"db:migrate:local": "wrangler d1 migrations apply DB --local"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.3",
		"@types/node": "^26.6.6",
		"typescript": "^5.9.3",
		"vitest": "~5.0.3",
		"wrangler": "^4.160.0"
	},
	"dependencies": {
		"hono": "^4.13.17",
		"jose": "^6.2.17"
	}
}
